# Environment configuration for the Gemini Enterprise Universal MCP Identity Broker
#
# Copy to .env for local development:  cp .env.example .env
#
# In production, separate Cloud Run instances are deployed per SaaS vendor
# using ./deploy.sh (e.g. VENDOR=metaview ./deploy.sh or VENDOR=greenhouse ./deploy.sh).
# Secrets are mounted from Secret Manager with --set-secrets and must NEVER be plaintext.

# --- Public URL -------------------------------------------------------------
# Must match the deployed Cloud Run service URL, e.g. https://ge-metaview-proxy-xyz.a.run.app
PROXY_BASE_URL=http://localhost:8080

# --- Gemini Enterprise credentials ------------------------------------------
# Configured in the Gemini Enterprise / Vertex AI Search console for this MCP server
GE_CLIENT_ID=ge-metaview-client
GE_CLIENT_SECRET=replace_with_a_secure_random_hex_key

# --- Upstream SaaS Provider Configuration -----------------------------------
# Identifier for this service instance (e.g. metaview, greenhouse, carta)
UPSTREAM_SERVICE_NAME=metaview

# Upstream OAuth Application Credentials
# Note: For public PKCE clients (e.g. Metaview), client secret is empty.
UPSTREAM_CLIENT_ID=replace_with_upstream_client_id
UPSTREAM_CLIENT_SECRET=

# Upstream OAuth & MCP Endpoints
UPSTREAM_AUTH_URL=https://auth.metaview.ai/oauth2/authorize
UPSTREAM_TOKEN_URL=https://auth.metaview.ai/oauth2/token
UPSTREAM_MCP_URL=https://mcp.metaview.ai/mcp
UPSTREAM_SCOPES=openid profile email offline_access

# Optional parameters (leave blank if not required by provider)
# - UPSTREAM_RESOURCE: RFC 8707 Resource Indicator (required by Metaview)
# - UPSTREAM_AUDIENCE: Audience parameter (required by some Auth0/Okta backed services)
# - UPSTREAM_REGISTRATION_URL: RFC 7591 Dynamic Client Registration endpoint (if supported)
UPSTREAM_RESOURCE=https://mcp.metaview.ai/mcp
UPSTREAM_AUDIENCE=
UPSTREAM_REGISTRATION_URL=https://auth.metaview.ai/oauth2/register

# --- Preset Configurations for Other Providers ---
#
# Read from each provider's own OAuth discovery documents on 2026-09-23.
# Re-verify with:
#   curl -s https://<mcp-host>/.well-known/oauth-protected-resource/mcp
#   curl -s https://<auth-host>/.well-known/oauth-authorization-server
#
# Carta CRM (the MCP host is also the authorization server):
#   UPSTREAM_SERVICE_NAME=carta
#   UPSTREAM_AUTH_URL=https://mcp.app.carta.com/authorize
#   UPSTREAM_TOKEN_URL=https://mcp.app.carta.com/token
#   UPSTREAM_MCP_URL=https://mcp.app.carta.com/mcp
#   UPSTREAM_SCOPES=openid cuid read_mcp_firms read_mcp_companies read_mcp_crm
#   UPSTREAM_RESOURCE=https://mcp.app.carta.com/mcp
#   UPSTREAM_AUDIENCE=
#   UPSTREAM_REGISTRATION_URL=https://mcp.app.carta.com/register
#   UPSTREAM_CLIENT_SECRET=      <- MUST stay empty. Carta advertises only
#                                   "none" and "private_key_jwt"; sending a
#                                   client_secret fails the token exchange.
#
# Greenhouse (resource, authorization server and DCR are on three hosts):
#   UPSTREAM_SERVICE_NAME=greenhouse
#   UPSTREAM_AUTH_URL=https://auth.greenhouse.io/authorize
#   UPSTREAM_TOKEN_URL=https://auth.greenhouse.io/token
#   UPSTREAM_MCP_URL=https://mcp.greenhouse.io/mcp
#   UPSTREAM_SCOPES=greenhouse:mcp_client
#   UPSTREAM_RESOURCE=https://mcp.greenhouse.io/mcp
#   UPSTREAM_AUDIENCE=
#   UPSTREAM_REGISTRATION_URL=https://mcp.greenhouse.io/oauth/register

# --- Storage ----------------------------------------------------------------
# secret_manager (default) or memory. Use memory for local dev without GCP creds.
STORAGE_BACKEND=secret_manager
GCP_PROJECT_ID=your-gcp-project-id
SECRET_PREFIX=ge-mv

# --- Token lifetimes --------------------------------------------------------
# PROXY_ACCESS_TOKEN_EXPIRES_IN is enforced, not just advertised: after this many
# seconds a proxy access token is rejected at /mcp and the client must refresh.
# PROXY_REFRESH_TOKEN_EXPIRES_IN is an absolute ceiling measured from the original
# sign-in, so a session cannot renew itself forever. Matches the 30-day Secret Manager TTL.
# PROXY_TOKEN_REVOCATION_GRACE_SECONDS is how long a token superseded by a refresh
# keeps working, so requests already in flight during rotation do not fail.
PROXY_ACCESS_TOKEN_EXPIRES_IN=3600
PROXY_REFRESH_TOKEN_EXPIRES_IN=2592000
PROXY_TOKEN_REVOCATION_GRACE_SECONDS=60

# --- Observability ----------------------------------------------------------
# Project number and region are used to build the Agent Registry telemetry URN.
# Resolve with: gcloud projects describe <PROJECT_ID> --format='value(projectNumber)'
GCP_PROJECT_NUMBER=
GCP_REGION=us-central1
OTEL_ENABLED=true

# --- Local development tooling ----------------------------------------------
# Mounts the interactive /test browser console.
# WARNING: localhost only. The console exposes unauthenticated endpoints that return
# a live user's proxy access token. Never enable on a deployed service.
ENABLE_TEST_CONSOLE=false
